<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 【非常重要】在这里填入你的 Steam 蔚蓝本地游戏文件夹路径 -->
    <CelesteRoot>C:\Program Files\Steam\steamapps\common\Celeste</CelesteRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 蔚蓝游戏本体代码 -->
    <Reference Include="Celeste">
      <HintPath>$(CelesteRoot)\Celeste.dll</HintPath>
      <!-- Private=false 极其重要！它防止编译时把上百MB的游戏本体复制到你的Mod里 -->
      <Private>false</Private>
    </Reference>
    
    <!-- Everest API 提供的 Hook 库，很多 Helper 都会用到 -->
    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelesteRoot)\MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- 游戏底层引擎 FNA (处理图像、声音等) -->
    <Reference Include="FNA">
      <HintPath>$(CelesteRoot)\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Everest 用到的配置解析库 -->
    <Reference Include="YamlDotNet">
      <HintPath>$(CelesteRoot)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 自动化魔法：编译成功后，自动把 .dll 和报错用的 .pdb 丢进你的游戏 Mods 文件夹里 -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CelesteRoot)\Mods\KevinCrusher\Code" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CelesteRoot)\Mods\KevinCrusher\Code" />
  </Target>

</Project>
