<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CelesteRoot>$(CELESTEGAMEPATH)</CelesteRoot>
  </PropertyGroup>
  
  <Target Name="CheckCelesteRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CELESTEGAMEPATH)' == ''" Text="【编译失败】未检测到系统环境变量 CELESTEGAMEPATH，请先在电脑中配置它！" />
  </Target>

  <ItemGroup>
    <Reference Include="Celeste">
      <HintPath>$(CelesteRoot)\Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelesteRoot)\MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <Reference Include="FNA">
      <HintPath>$(CelesteRoot)\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="YamlDotNet">
      <HintPath>$(CelesteRoot)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CelesteRoot)\Mods\ShaojiaHelper\Code" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CelesteRoot)\Mods\ShaojiaHelper\Code" />
  </Target>

</Project>