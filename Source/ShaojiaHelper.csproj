<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Celeste install directory is read from .celeste-path in the repository root (see README) -->
    <CelestePathFile>$(MSBuildThisFileDirectory)../.celeste-path</CelestePathFile>
  </PropertyGroup>

  <!-- CelesteRoot resolution order: -p:CelesteRoot=... on the command line, then .celeste-path -->
  <PropertyGroup Condition="'$(CelesteRoot)' == ''">
    <CelesteRoot Condition="Exists('$(CelestePathFile)')">$([System.IO.File]::ReadAllText('$(CelestePathFile)').Trim())</CelesteRoot>
  </PropertyGroup>

  <Target Name="CheckCelesteRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CelesteRoot)' == ''" Text="[Build error] Celeste install path not found. Create a .celeste-path file in the repository root containing the Celeste directory (see README)." />
    <Error Condition="!Exists('$(CelesteRoot)/Celeste.dll')" Text="[Build error] '$(CelesteRoot)' does not contain Celeste.dll. Please check .celeste-path." />
  </Target>

  <ItemGroup>
    <Reference Include="Celeste">
      <HintPath>$(CelesteRoot)/Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MMHOOK_Celeste">
      <HintPath>$(CelesteRoot)/MMHOOK_Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="FNA">
      <HintPath>$(CelesteRoot)/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="YamlDotNet">
      <HintPath>$(CelesteRoot)/YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(CelesteRoot)' != ''">
    <PropertyGroup>
      <ModCodeDir>$(CelesteRoot)/Mods/ShaojiaHelper/Code</ModCodeDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModCodeDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModCodeDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModCodeDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
